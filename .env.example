# ==========================================
# Garvi Education - Environment Configuration
# ==========================================

# 1. Razorpay Payment Gateway (Test Mode / Live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 2. AiSensy WhatsApp Business Platform
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_NAME=garvi_workshop_confirmation
AISENSY_REMINDER_CAMPAIGN=garvi_workshop_reminder

# 3. Transactional Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=Garvi Education <workshops@garvieducation.com>

# 4. Meta Pixel & Meta Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# 5. Admin Authentication
ADMIN_PASSWORD=garvi@admin2026
ADMIN_SECRET_TOKEN=garvi_secure_admin_session_token_2026

# 6. Database (Optional: If using external PostgreSQL / Supabase)
# By default, local SQLite database is stored in data/garvi.db
DATABASE_URL=
